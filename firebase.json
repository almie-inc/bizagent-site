{
	"hosting": {
		"site": "bizagent-site",
		"public": "out",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"cleanUrls": true,
		"trailingSlash": true,
		"headers": [
			{
				"source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff2)",
				"headers": [
					{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
				]
			},
			{
				"source": "**/*.@(html)",
				"headers": [
					{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
				]
			}
		]
	}
}
